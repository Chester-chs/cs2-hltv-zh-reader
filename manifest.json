{
  "manifest_version": 3,
  "name": "CS2 HLTV Chinese Reader",
  "version": "0.0.1",
  "description": "Translate eligible English text on HLTV pages into Chinese.",
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.hltv.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cs2-hltv-zh-reader@chester-chs.github.io"
    }
  }
}
